# Exemplo de configuração — copie para .env e ajuste. NUNCA versione o .env real.
# Gere segredos fortes (ex.: `openssl rand -base64 32`).

# --- Ambiente ---
# dev (default): defaults de conveniência valem (mapa selado default, OTP no console se
# EMAIL_DEV_CONSOLE=1). production/prod: liga o guard de startup (app/core/config.py), que
# RECUSA subir sem a chave selada configurada ou com EMAIL_DEV_CONSOLE ligado.
APP_ENV=dev

# --- Banco (Postgres em produção) ---
POSTGRES_USER=sereno
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sereno
# Opcional: sobrescrever a URL completa (senão é montada a partir das vars acima).
# DATABASE_URL=postgresql+psycopg://sereno:troque-esta-senha@db:5432/sereno
# Timeout de CONEXÃO ao Postgres, em segundos (ADR-090). Curto de propósito: banco
# inalcançável na rede penduraria pelo default do SO (minutos) e travaria o worker/o /ready.
# DB_CONNECT_TIMEOUT_S=5

# --- Redis (rate limit, denylist de jti, fila) ---
REDIS_URL=redis://redis:6379/0
# Postura quando o Redis está fora (ADR-079): 1=fail-open (padrão, prioriza
# disponibilidade — não derruba login/OTP/auth); 0=fail-closed (prioriza a defesa: 429/401).
# SECURITY_FAIL_OPEN=1

# --- Segredos da aplicação ---
JWT_SECRET=troque-por-um-segredo-de-32+bytes
PII_ENC_KEY=troque-por-base64-de-32-bytes    # KEK ativa da PII (base64 32 bytes; openssl rand -base64 32)
ALLOCATION_SEED=troque-por-semente-de-alocacao
# Blocos permutados da randomização (protocolo: 4 e 6; ADR-104). Tamanho FIXO torna a última
# posição de cada bloco previsível para quem acompanha as alocações. A variável antiga no
# singular (ALLOCATION_BLOCK_SIZE) é RECUSADA no startup, de propósito.
ALLOCATION_BLOCK_SIZES=4,6
# Custódia/rotação da chave de PII (ADR-087). Rotação: dê um id à chave ativa e mantenha as
# aposentadas p/ decifrar o que já existe (o id viaja no ciphertext; não re-cifra tudo de uma vez).
# PII_ENC_KEY_ID=env1                          # id da KEK ativa (default env1)
# PII_ENC_KEYS=k1:base64de32bytes,k0:...       # chaves APOSENTADAS (só decifram) durante a rotação
#
# Custódia em COFRE (ADR-095): com KEY_PROVIDER=vault a KEK nunca sai do Vault — a app só pede
# wrap/unwrap. O dado cifrado antes continua legível pelo PII_ENC_KEY acima (migração incremental).
# A chave do Transit PRECISA ser criada com derived=true, senão a amarração participante+campo
# some SEM ERRO VISÍVEL:  vault write -f transit/keys/sereno-pii-kek derived=true
# KEY_PROVIDER=vault
# VAULT_ADDR=https://vault.interno:8200
# VAULT_TOKEN=                                 # segredo crítico; só no cabeçalho, nunca em log/URL
# VAULT_TRANSIT_KEY=sereno-pii-kek
# VAULT_TRANSIT_MOUNT=transit
# VAULT_TIMEOUT_S=5                            # Vault fora = PII ilegível (falha explícita)

# Chave SELADA A/B->condição. NÃO É UM EXEMPLO A COPIAR: o valor real é um SORTEIO
# custodiado (ex.: A:sham,B:active OU A:active,B:sham — decidido pelo custodiante, tipicamente
# a orientadora), conhecido só por ele e aberto no data lock. Custodiar SEPARADAMENTE
# (cofre/KMS); em produção, setar como secret — o deploy RECUSA subir sem ela (ver ADR-077).
# Em dev, deixe VAZIO/ausente: o código usa um default só-dev (A:active,B:sham).
# ARM_CONDITION_MAP=

# --- Entrega de áudio (E3/ADR-082) ---
# inline (default): o backend transmite o WAV pelo caminho autenticado (comportamento A1).
# signed-url: GET /sessions/{id}/audio responde 302 p/ uma URL assinada de curta duração
# em /v1/audio/{content_hash} (capability = assinatura, sem Authorization). Prepara offload.
# AUDIO_DELIVERY=inline
# Chave dedicada p/ assinar as URLs de áudio (HMAC). Se ausente, deriva do JWT_SECRET.
# AUDIO_URL_SIGNING_KEY=troque-por-um-segredo-de-32+bytes
# AUDIO_URL_TTL_S=300        # validade da URL assinada, em segundos (padrão 300)
# AUDIO_CACHE_DIR=           # diretório do cache do áudio materializado (padrão <backend>/.audio_cache)
#
# Formato do artefato servido (G1/ADR-103). "flac" (padrão) é SEM PERDAS — o PCM decodificado
# é idêntico ao do WAV — e derruba uma sessão de 20 min de 230 MB para ~33 MB, que é o que
# torna o piloto viável em rede móvel. "wav" só para depuração ou ambiente sem libsndfile;
# nesse caso o cliente baixa 230 MB por protocolo. Trocar o valor INVALIDA o cache
# (a extensão faz parte do nome do arquivo) e muda o ETag, então o app rebaixa o áudio.
# AUDIO_FORMAT=flac
# ROTAÇÃO da chave de assinatura (ADR-090): a ativa acima é a única que ASSINA; as anteriores
# seguem aceitas só p/ VERIFICAR, para não invalidar URL já entregue (quem está ouvindo não cai).
# Passado o TTL da URL, REMOVA a anterior — mantê-la para sempre anula a rotação.
# AUDIO_URL_SIGNING_KEYS_PREVIOUS=chave-anterior,outra-mais-antiga
# Freio do endpoint PÚBLICO de áudio, por IP (ADR-090). Generoso p/ o uso real; suba se um
# NAT compartilhado (laboratório) tomar 429 — não remova.
# AUDIO_RATE_LIMIT=60
# AUDIO_RATE_WINDOW_S=60
# --- Teto de volume por software (G3/ADR-101) ---
# Ganho digital MÁXIMO aceito ao iniciar sessão (0 < g <= 1). O app declara o ganho travado
# com que vai reproduzir e o servidor recusa (422) acima deste teto — é o "limite imposto por
# software" do protocolo. O valor que corresponde a 60 dB(A) sai da CALIBRAÇÃO em acoplador
# de orelha (etapa (i)); enquanto ela não for feita, o padrão 1.0 não restringe nada.
# Ao definir aqui, ajuste também o build do app: --dart-define=AUDIO_GAIN_MILLI=<g*1000>.
# AUDIO_MAX_GAIN=1.0

# --- Vestíveis (E2/ADR-084) — seam de ingestão ---
# null (default): aceita e DESCARTA as leituras (seam preparado, não persiste). memory: guarda
# em memória (teste/demo). Persistência real é um adaptador futuro (dado de saúde = sensível).
# WEARABLE_SINK=null

# --- E-mail (OTP do participante + alerta de evento adverso) ---
# Provedores comuns: 587 = STARTTLS (default); 465 = SSL implícito (autodetectado, ou
# force com SMTP_USE_SSL=1). Sem SMTP em produção, o OTP não é entregue (não vaza, mas o
# participante não recebe). Em dev, EMAIL_DEV_CONSOLE=1 imprime o código no console.
SMTP_HOST=
SMTP_PORT=587
# SMTP_USE_SSL=            # 1 para SSL implícito quando o provedor não usa 587/STARTTLS
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sereno.example
TEAM_NOTIFY_EMAIL=
# EMAIL_DEV_CONSOLE=1      # DEV apenas — imprime o OTP no console. O guard recusa em produção.
# Entrega (ADR-085/092): inline (default, síncrono), background (thread pool; o request não
# espera o SMTP) ou queue (fila RQ/Redis — DURÁVEL: sobrevive a restart/deploy).
# EMAIL_DELIVERY=background
# EMAIL_WORKERS=2           # nº de threads de envio quando EMAIL_DELIVERY=background
#
# Modo `queue` (ADR-092) — exige REDIS_URL e um WORKER rodando, senão nada é enviado:
#   python scripts/email_worker.py            (--burst drena a fila e sai)
# O job carrega o corpo (com o código OTP), então tem TTL curto e não deixa job morto no Redis.
# EMAIL_DELIVERY=queue
# EMAIL_QUEUE=sereno-email  # nome da fila; API e worker precisam concordar
# EMAIL_JOB_TTL=600         # segundos que o job pode esperar na fila (ordem da validade do OTP)
# EMAIL_JOB_RETRIES=3       # reintentos do worker p/ falha TRANSITÓRIA (10s, 60s, 300s).
#                           # Bounce (5xx) nunca é reintentado: conta emails_total{outcome=bounced}

# --- Convite / redefinição de senha de staff (F4.7/ADR-094) ---
# Pepper do token de convite/reset: um vazamento do banco não permite testar tokens sem ele.
# TROCAR em produção (mesma disciplina do OTP_PEPPER).
# STAFF_SETUP_PEPPER=dev-staff-setup-pepper-trocar
# STAFF_INVITE_TTL_H=72     # validade do convite (a pessoa precisa achar tempo)
# STAFF_RESET_TTL_H=2       # validade da redefinição (reação a problema em curso: janela curta)
# Página que recebe o token e chama POST /v1/staff/setup-password. É o próprio app web
# (ADR-096): com `?token=` na URL ele abre a tela de definir senha em vez do login do
# participante. Aponte para a RAIZ do app — o `?token=` é acrescentado pelo backend, que
# respeita uma query já existente (ex.: `?api=`). Sem esta variável, o e-mail carrega o
# token cru e o staff precisa chamar a API na mão.
# STAFF_SETUP_URL=https://yh6k6hwbds-coder.github.io/sereno/
# STAFF_SETUP_RATE_LIMIT=10 # tentativas/min por IP no endpoint público

# --- Alertas automáticos (F4.6/ADR-093) ---
# Detecção em processo: conta sintomas numa janela e avisa TEAM_NOTIFY_EMAIL (acima) ao
# cruzar o limiar. Sem TEAM_NOTIFY_EMAIL o alerta ainda conta e vai para o log.
# O aviso NUNCA contém participante, ator, endereço, código ou braço.
# ALERTS_ENABLED=1
# Regras: email_failure (R-06), auth_failure, server_error, research_access (R-03).
# Ajuste sem mexer em código — os padrões são chute inicial, calibrar nas primeiras semanas:
# ALERT_EMAIL_FAILURE_THRESHOLD=3      # em ALERT_EMAIL_FAILURE_WINDOW_S=900
# ALERT_AUTH_FAILURE_THRESHOLD=25      # em ALERT_AUTH_FAILURE_WINDOW_S=300
# ALERT_SERVER_ERROR_THRESHOLD=10      # em ALERT_SERVER_ERROR_WINDOW_S=300
# ALERT_RESEARCH_ACCESS_THRESHOLD=200  # em ALERT_RESEARCH_ACCESS_WINDOW_S=3600
# ALERT_<REGRA>_COOLDOWN_S             # silêncio após disparar (anti-tempestade)

# --- Retenção: expurgo de transitórios (E2/ADR-091) ---
# Minutos APÓS a expiração antes de apagar um desafio de OTP. Não é prazo de retenção: é
# folga p/ não competir com requisição em voo. O job é DIÁRIO (política §4, nunca > 24 h).
# Rodar: python scripts/purge_otp.py  (--dry-run p/ só contar). Precisa ser AGENDADO —
# sem cron/máquina agendada o expurgo não acontece. Ver docs/deploy-fly.md.
# OTP_PURGE_GRACE_MIN=60
