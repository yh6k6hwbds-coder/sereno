# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
# Backups do .env (ex.: .env.bak-20260824) carregam os MESMOS segredos e não estavam cobertos
# pela regra acima — um `git add -A` distraído versionaria a chave de PII.
.env.*
!.env.example
*.egg-info/
.pytest_cache/
.ruff_cache/
# Node / Flutter
node_modules/
.dart_tool/
build/
.flutter-plugins*
# Áudio renderizado (gerado pela pipeline/backend; não versionar binários grandes)
audio-pipeline/out/
backend/.audio_cache/
*.wav
*.flac
# Bancos de teste locais (CI-espelho SQLite)
*.db
# Segredos e dados — NUNCA versionar
*.pem
*.key
secrets/
data/
# SO / editor
.DS_Store
.idea/
.vscode/

# Cobertura de testes
.coverage
.coverage.*
htmlcov/

# Artefatos de build do app
*.apk
app/android/
app/web/
app/ios/
